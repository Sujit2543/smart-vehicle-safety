NODE_ENV=production
PORT=5000
API_PREFIX=/api/v1

# ── Database ──────────────────────────────────────────────────
# On Railway: use the Railway PostgreSQL plugin — it sets DATABASE_URL automatically
DATABASE_URL=postgresql://user:password@host:5432/cardeal_db

# ── JWT ───────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=change_me_to_32_char_random_string
JWT_REFRESH_SECRET=change_me_to_different_32_char_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── AWS S3 (optional — for document uploads) ──────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=cardeal-documents-private
AWS_S3_PRESIGNED_URL_TTL=900

# ── OTP ───────────────────────────────────────────────────────
# OTP is returned in the API response and shown on screen — no SMS provider needed.
OTP_EXPIRY_SECONDS=600
OTP_MAX_ATTEMPTS=10

# ── WhatsApp (optional) ───────────────────────────────────────
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_ID=
META_WHATSAPP_API_VERSION=v18.0

# ── Masked calling (optional) ─────────────────────────────────
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_SID=
EXOTEL_VIRTUAL_NUMBER=

# ── Email (optional) ──────────────────────────────────────────
SENDGRID_API_KEY=
EMAIL_FROM=noreply@cardeal.com
EMAIL_FROM_NAME=Car Deal Safety

# ── CORS ─────────────────────────────────────────────────────
# Add your Vercel frontend URL here.
# *.vercel.app and *.up.railway.app wildcards are always allowed automatically.
FRONTEND_URL=https://your-app.vercel.app
ALLOWED_ORIGINS=https://your-app.vercel.app

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
OTP_RATE_LIMIT_MAX=50

APP_NAME=Car Deal Smart Safety Tag
TAG_ID_PREFIX=CD
TAG_ID_START=1001

# ── BASE_URL ──────────────────────────────────────────────────
# Set to your Vercel frontend URL — used for QR code generation
BASE_URL=https://your-app.vercel.app
DOCUMENT_PIN_MAX_ATTEMPTS=5
DOCUMENT_PIN_LOCKOUT_MINUTES=30
