# ── Local development ─────────────────────────────────────────
# Leave VITE_API_BASE_URL as /api/v1 — Vite dev server proxies it to localhost:5000
VITE_API_BASE_URL=/api/v1

# ── Production (Vercel) ───────────────────────────────────────
# Set this in your Vercel project → Settings → Environment Variables
# VITE_API_BASE_URL=https://your-backend.up.railway.app/api/v1

VITE_APP_NAME=Car Deal Smart Safety Tag

# QR code base URL — must match where the frontend is served
# Local: your LAN IP so phones can open QR links (run ipconfig to find it)
# Production: your Vercel URL
VITE_APP_BASE_URL=http://localhost:3000
# VITE_APP_BASE_URL=https://your-app.vercel.app
